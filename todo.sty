\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{todo}[2026/11/03 To-do macro with summary list]

% Usage:
%   \todo{<details>}{<target-closing-date>}
%   \listoftodos          % summary section, like the acronym list
% Each item gets an automatic ID TBD<number>. With hyperref (loaded after
% this package), the margin ID links to its row in the summary table, and
% the page number in the table links back to the margin note.
% Entries are written to \jobname.tdl and read back on the next run,
% so LaTeX must be run twice (compile.sh already does this).
% Draft mode only: the ID is printed in the margin and \listoftodos prints
% the summary. In final mode (default) \todo and \listoftodos print nothing.
% Package options: `draft' enables draft mode, `final' disables it (default).
% Use \usepackage[draft]{todo} rather than the class option `draft', which
% would also turn graphicx figures into empty boxes.

\RequirePackage{xcolor}
\RequirePackage{longtable}
\RequirePackage{booktabs}

\newif\iftodo@draft
\DeclareOption{draft}{\todo@drafttrue}
\DeclareOption{final}{\todo@draftfalse}
\DeclareOption*{\PackageWarning{todo}{Unknown option `\CurrentOption'}}
\ProcessOptions\relax

\newwrite\todo@file
\def\todo@rows{}

\newcounter{todo}
\renewcommand{\thetodo}{TBD\arabic{todo}}

% Called once per line of the .tdl file: {number}{page}{date}{details}
\def\todoentry#1#2#3#4{%
  \g@addto@macro\todo@rows{%
    \hypertarget{todo:#1}{\texttt{TBD#1}} & #4 & #3 &
    \hyperlink{todo:src:#1}{#2}\\}}

\iftodo@draft
  \AtBeginDocument{%
    \InputIfFileExists{\jobname.tdl}{}{}%
    \immediate\openout\todo@file=\jobname.tdl\relax}
  \newcommand{\todo}[2]{%
    \refstepcounter{todo}%
    \protected@write\todo@file{}{%
      \string\todoentry{\arabic{todo}}{\thepage}{#2}{#1}}%
    \marginpar{\raggedright\footnotesize\textcolor{red}{%
      \hypertarget{todo:src:\arabic{todo}}{}%
      \hyperlink{todo:\arabic{todo}}{\textbf{\thetodo}}}}}
\else
  \newcommand{\todo}[2]{}
\fi

\iftodo@draft
\newcommand{\listoftodos}{%
  \section*{To-do list}%
  \addcontentsline{toc}{section}{To-do list}%
  \ifx\todo@rows\@empty
    No open to-do items.%
  \else
    \begin{longtable}{@{}l p{0.52\linewidth} l r@{}}
      \toprule
      \textbf{ID} & \textbf{Details} & \textbf{Target date} & \textbf{Page}\\
      \midrule
      \endhead
      \todo@rows
      \bottomrule
    \end{longtable}%
  \fi}
\else
\newcommand{\listoftodos}{}
\fi
